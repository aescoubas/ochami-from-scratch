#!ipxe

echo "=============================================="
echo "OpenCHAMI Network Boot"
echo "Server: 192.168.100.1:80"
echo "=============================================="

set base-url http://192.168.100.1:80

echo "Loading kernel..."
kernel ${base-url}/artifacts/nixos/vmlinuz-lts init=/nix/store/d3hxpxs4i97yxhg6iqhmc7n1bw6p9ywm-nixos-system-ochami-netboot-kexec-25.11.20260306.71caefc/init console=ttyS0,115200n8 console=tty0 ip=dhcp nohibernate loglevel=4 lsm=landlock,yama,bpf

echo "Loading initramfs..."
initrd ${base-url}/artifacts/nixos/initramfs-lts

echo "Booting..."
boot
