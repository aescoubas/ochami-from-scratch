# OpenCHAMI Docker Compose Environment Variables
# Copy this file to .env and adjust values as needed.
# The deploy script generates .env automatically.

# Host networking
HOST_IP=192.168.100.2
PXE_INTERFACE=virbr-pxe
DHCP_START=192.168.100.100
DHCP_END=192.168.100.200
DHCP_NETMASK=255.255.255.0
PXE_CIDR=24

# Service ports
HTTP_PORT=80
SMD_PORT=27779
BSS_PORT=27778
POSTGRES_PORT=5432

# Postgres superuser
POSTGRES_USER=ochami
POSTGRES_PASSWORD=CHANGEME

# SMD database
SMD_DB_NAME=hmsds
SMD_DB_USER=smd-user
SMD_DB_PASSWORD=CHANGEME

# BSS database
BSS_DB_NAME=bssdb
BSS_DB_USER=bss-user
BSS_DB_PASSWORD=CHANGEME

# Kea database
KEA_DB_NAME=kea
KEA_DB_USER=kea-user
KEA_DB_PASSWORD=CHANGEME

# PCS (Power Control) database
PCS_DB_NAME=pcsdb
PCS_DB_USER=pcs-user
PCS_DB_PASSWORD=CHANGEME

# PCS port
PCS_PORT=28007

# Hydra database (reserved)
HYDRA_DB_PASSWORD=CHANGEME

# VM configuration
NUM_VMS=0

# Project root (set by deploy script)
PROJECT_ROOT=.
