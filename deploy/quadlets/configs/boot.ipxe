#!ipxe

echo "=============================================="
echo "OpenCHAMI Network Boot"
echo "Server: $OPENCHAMI_BASE_IP:80"
echo "=============================================="

set base-url http://$OPENCHAMI_BASE_IP:80

echo "Chainloading BSS boot script..."
chain ${base-url}/boot/v1/bootscript?mac=${mac}&arch=${buildarch} || goto retry

:retry
sleep 10
chain ${base-url}/boot/v1/bootscript?mac=${mac}&arch=${buildarch}&retry=1
