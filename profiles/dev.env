# Profile: dev
# Development profile with main branch refs.
PROFILE_NAME=dev
IMAGE_PREFIX=
IMAGE_REGISTRY=

# Source refs (all tracking main)
SMD_REF=main
BSS_REF=main
CLOUD_INIT_REF=main
PCS_REF=main
KEA_SYNC_REF=main

# Source repos
SMD_REPO=https://github.com/openchami/smd.git
BSS_REPO=https://github.com/openchami/bss.git
PCS_REPO=https://github.com/OpenCHAMI/power-control.git
CLOUD_INIT_REPO=https://github.com/openchami/cloud-init.git
KEA_SYNC_REPO=https://github.com/aescoubas/kea-sync.git

# Upstream images
POSTGRES_IMAGE=docker.io/postgres:11.5-alpine
KEA_DHCP4_IMAGE=docker.io/jonasal/kea-dhcp4:3.1.4
KEA_ADMIN_IMAGE=docker.io/jonasal/kea-admin:3.1.4
STORK_SERVER_IMAGE=docker.io/signalorange/stork:ubuntu24.04-1.19.0
NGINX_IMAGE=docker.io/nginx:alpine

# Ports
SMD_PORT=27779
BSS_PORT=27778
POSTGRES_PORT=15432
HTTP_PORT=80
CLOUD_INIT_PORT=27777
PCS_PORT=28007
KEA_CTRL_PORT=8000
KEA_SYNC_PORT=28080

# Database names and users
SMD_DB_NAME=hmsds
SMD_DB_USER=smd-user
BSS_DB_NAME=bssdb
BSS_DB_USER=bss-user
KEA_DB_NAME=kea
KEA_DB_USER=kea-user
PCS_DB_NAME=pcsdb
PCS_DB_USER=pcs-user
POSTGRES_SUPERUSER=ochami
