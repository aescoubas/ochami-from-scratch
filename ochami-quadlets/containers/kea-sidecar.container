[Unit]
Description=OpenCHAMI Kea SMD Sync Sidecar
After=smd.service kea.service
Requires=smd.service kea.service

[Container]
Image=python:3.9-slim
Network=host
Exec=sh -c "pip install psycopg2-binary requests && python /scripts/smd_sync.py"
Environment=SMD_URL=http://localhost:27779
Environment=DB_HOST=localhost
EnvironmentFile=/etc/openchami/openchami.env
Volume=/etc/openchami/configs/smd_sync.py:/scripts/smd_sync.py:ro

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=openchami.target
