#!ipxe

echo "=============================================="
echo "OpenCHAMI Network Boot"
echo "Server: 148.187.1.68:80"
echo "=============================================="

set base-url http://148.187.1.68:80

echo "Loading kernel..."
kernel ${base-url}/artifacts/almalinux/vmlinuz ip=dhcp inst.repo=https://repo.almalinux.org/almalinux/9.7/BaseOS/x86_64/os/ inst.text console=ttyS0,115200n8 console=tty0

echo "Loading initramfs..."
initrd ${base-url}/artifacts/almalinux/initrd.img

echo "Booting..."
boot
