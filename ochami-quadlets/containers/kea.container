[Unit]
Description=OpenCHAMI Kea DHCP4 Server
After=kea-init.service
Requires=kea-init.service

[Container]
Image=jonasal/kea-dhcp4:3.1.4
Network=host
AddCapability=NET_RAW
AddCapability=NET_ADMIN
Exec=-c /etc/kea/kea-dhcp4.conf
Volume=/etc/openchami/configs/kea-dhcp4.conf:/etc/kea/kea-dhcp4.conf:ro
Volume=kea-sockets:/kea/sockets

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=openchami.target
